# Windows reserved device name; tools that redirect to NUL under Git Bash /
# an SSH client (podman machine ssh -o UserKnownHostsFile=NUL) create it as a file.
NUL
.claude/unattended.json

src/Atlas.Web/obj/
src/Atlas.Web/obj\\*/
packages.lock.json

# Wolverine handler code generated at build time for production (Dockerfile: codegen write)
src/*.Server/Internal/Generated/
