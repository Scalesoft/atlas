<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Part of Atlas since 2026-10-26: versioned and built with it (Directory.Build.props), never packed or published. -->
    <IsPackable>false</IsPackable>
    <Description>Yjs relay and persistence contracts over ASP.NET Core SignalR, the editor's document validator, an optional managed Yjs content guard and a managed materializer of the editor's document.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by src/Atlas.Markdown/src/schema/manifest.test.ts; the npm package ships the same file. -->
    <EmbeddedResource Include="../Atlas.Markdown/schema/markdown-schema.json" LogicalName="Atlas.Markdown.Sync.markdown-schema.json" Link="Schema/markdown-schema.json" />
    <!-- The one palette of collaborator colours; the editor imports the same file. -->
    <EmbeddedResource Include="../Atlas.Markdown/src/core/collaboratorColors.json" LogicalName="Atlas.Markdown.Sync.collaborator-colors.json" Link="Schema/collaborator-colors.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Markdown.Sync.Tests" />
    <InternalsVisibleTo Include="Atlas.Yjs.Tests" />
    <Using Include="Atlas.Yjs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Atlas.Yjs/Atlas.Yjs.csproj" />
  </ItemGroup>
</Project>
