+/**
+ * Atlas patch: replaces only the part of `oldDoc` that differs from `content` (y-tiptap replaces the whole
+ * document on every remote change, so every decoration and plugin recomputes the whole page). Returns null
+ * when the result would not be exactly `content`; the caller then replaces the whole document as before.
+ *
+ * @param {import('prosemirror-state').Transaction} tr
+ * @param {import('prosemirror-model').Node} oldDoc
+ * @param {Array<import('prosemirror-model').Node>} content
+ * @return {import('prosemirror-state').Transaction|null}
+ */
+const replaceChangedRange = (tr, oldDoc, content) => {
+  if (content.length === 0) return null
+  const fragment = PModel.Fragment.from(content);
+  const start = oldDoc.content.findDiffStart(fragment);
+  if (start === null) return tr
+  const end = /** @type {{a: number, b: number}} */ (oldDoc.content.findDiffEnd(fragment));
+  let endA = end.a;
+  let endB = end.b;
+  // Repeated content around the change: both ends may overlap the start.
+  const overlap = start - math.min(endA, endB);
+  if (overlap > 0) {
+    endA += overlap;
+    endB += overlap;
+  }
+  try {
+    const newDoc = oldDoc.copy(fragment);
+    tr.replace(start, endA, newDoc.slice(start, endB));
+    return tr.doc.eq(newDoc) ? tr : null
+  } catch (e) {
+    return null
+  }
+};
